<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>客戶丈量追蹤管理系統 (Firebase 版)</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Vue 3 全域引入 -->
  <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- 引入 Google Fonts: Noto Serif TC (思源宋體) 包含 300(Light), 400(Regular), 500(Medium), 700(Bold) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@300;400;500;700&display=swap" rel="stylesheet">
  
  <style>
    [v-cloak] { display: none; }
    body { 
      -webkit-tap-highlight-color: transparent; 
      /* 全域套用 Noto Serif TC 與 預設 Light (300) 字重 */
      font-family: 'Noto Serif TC', serif;
      font-weight: 300;
    }
    /* 微調粗體顯示，避免宋體過粗時糊掉，改用 500 (Medium) 或 600 (SemiBold) 視覺較佳 */
    h1, h2, h3, h4, h5, h6, .font-bold {
      font-weight: 500 !important;
    }
    .font-semibold {
      font-weight: 400 !important;
    }
  </style>
</head>
<body class="bg-[#F0F4F8] text-slate-700 min-h-screen"> <!-- 使用帶有淡藍灰色的背景 -->

<div id="app" v-cloak class="max-w-7xl mx-auto px-3 py-4 sm:px-6 lg:px-8 pb-20">
  
  <header class="mb-5 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
    <div class="flex items-center gap-2">
      <!-- 統一改為深藍色 bg-blue-900 -->
      <span class="p-2 bg-blue-900 text-white rounded-lg shadow-sm border border-blue-800">
        <i class="fa-solid fa-cloud text-lg"></i>
      </span>
      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-blue-950 tracking-tight flex items-center gap-2">
          客戶丈量與追蹤管理 <span class="text-xs bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 rounded-full font-medium">雲端同步中</span>
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Firebase 即時資料庫・多裝置無縫接軌</p>
      </div>
    </div>
    
    <div class="flex flex-wrap items-center gap-2">
      <button @click="showReminderModal = true" class="relative inline-flex items-center gap-1.5 px-3 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs sm:text-sm rounded-lg shadow-sm transition">
        <i class="fa-solid fa-bell" :class="dueReminders.length > 0 ? 'text-amber-500 animate-bounce' : 'text-slate-400'"></i>
        待追蹤
        <span v-if="dueReminders.length > 0" class="ml-1 px-1.5 py-0.2 bg-rose-600 text-white text-[11px] font-bold rounded-full">
          {{ dueReminders.length }}
        </span>
      </button>

      <button @click="openModal()" class="inline-flex items-center gap-1 px-3 sm:px-4 py-2 bg-blue-900 hover:bg-blue-800 text-white text-xs sm:text-sm rounded-lg shadow-sm transition">
        <i class="fa-solid fa-plus"></i> 新增丈量
      </button>

      <button @click="exportCSV()" class="inline-flex items-center gap-1 px-3 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs sm:text-sm rounded-lg shadow-sm transition">
        <i class="fa-solid fa-file-excel text-emerald-600"></i> 匯出
      </button>
    </div>
  </header>

  <!-- ==================== 兩欄式主要佈局 ==================== -->
  <div class="flex flex-col md:flex-row gap-4 lg:gap-6 items-start">
    
    <!-- 左側邊欄：月份切換 -->
    <aside class="w-full md:w-44 lg:w-48 shrink-0 bg-white p-2 md:p-3 rounded-xl shadow-sm border border-slate-200 md:sticky md:top-4 z-10 overflow-x-auto md:overflow-visible scrollbar-thin">
      <div class="text-[11px] font-bold text-slate-400 mb-2 px-1 hidden md:block tracking-widest uppercase">月份篩選</div>
      <div class="flex md:flex-col gap-1.5 text-xs sm:text-sm">
        <button 
          @click="selectedMonth = 'ALL'"
          :class="selectedMonth === 'ALL' ? 'bg-blue-900 text-white shadow font-medium' : 'text-slate-600 hover:bg-slate-50 hover:text-blue-900'"
          class="px-3 md:px-4 py-2 md:py-2.5 rounded-lg transition text-center md:text-left whitespace-nowrap border border-transparent">
          全部資料
        </button>
        <button 
          v-for="m in availableMonths" :key="m"
          @click="selectedMonth = m"
          :class="selectedMonth === m ? 'bg-blue-900 text-white shadow font-medium' : 'text-slate-600 hover:bg-slate-50 hover:text-blue-900'"
          class="px-3 md:px-4 py-2 md:py-2.5 rounded-lg transition flex items-center justify-center md:justify-start gap-2 whitespace-nowrap border border-transparent">
          <i class="fa-regular fa-calendar-days text-xs" :class="selectedMonth === m ? 'text-blue-200' : 'text-slate-400'"></i> {{ m }}
        </button>
      </div>
    </aside>

    <!-- 右側：主內容區 -->
    <main class="flex-1 min-w-0 w-full space-y-4 lg:space-y-5">
      
      <!-- KPI 統計看板 -->
      <div class="grid grid-cols-2 xl:grid-cols-5 gap-3 sm:gap-4">
        <div class="bg-white p-3 sm:p-4 rounded-xl border border-slate-200 shadow-sm relative overflow-hidden">
          <div class="absolute top-0 right-0 p-3 opacity-10 text-4xl"><i class="fa-solid fa-folder-open"></i></div>
          <span class="text-xs font-semibold text-slate-500 relative z-10">總丈量件數</span>
          <div class="mt-1 flex items-baseline justify-between relative z-10">
            <span class="text-xl sm:text-2xl font-bold text-blue-950">{{ stats.total }} <span class="text-xs font-light text-slate-500">件</span></span>
          </div>
        </div>
        <div class="bg-white p-3 sm:p-4 rounded-xl border border-slate-200 shadow-sm border-l-4 border-l-emerald-500 relative overflow-hidden">
          <div class="absolute top-0 right-0 p-3 opacity-10 text-emerald-500 text-4xl"><i class="fa-solid fa-handshake"></i></div>
          <span class="text-xs font-semibold text-emerald-600 relative z-10">成交 / 成交率</span>
          <div class="mt-1 flex items-baseline justify-between relative z-10">
            <span class="text-xl sm:text-2xl font-bold text-emerald-700">{{ stats.won }} <span class="text-xs font-light text-emerald-600/70">件</span></span>
            <span class="text-xs sm:text-sm font-medium text-emerald-800 bg-emerald-50 border border-emerald-100 px-2 py-0.5 rounded-full">{{ stats.wonRate }}%</span>
          </div>
        </div>
        <div class="bg-white p-3 sm:p-4 rounded-xl border border-slate-200 shadow-sm border-l-4 border-l-amber-500 relative overflow-hidden">
          <div class="absolute top-0 right-0 p-3 opacity-10 text-amber-500 text-4xl"><i class="fa-solid fa-spinner"></i></div>
          <span class="text-xs font-semibold text-amber-600 relative z-10">追蹤中 / 比率</span>
          <div class="mt-1 flex items-baseline justify-between relative z-10">
            <span class="text-xl sm:text-2xl font-bold text-amber-700">{{ stats.pending }} <span class="text-xs font-light text-amber-600/70">件</span></span>
            <span class="text-xs sm:text-sm font-medium text-amber-800 bg-amber-50 border border-amber-100 px-2 py-0.5 rounded-full">{{ stats.pendingRate }}%</span>
          </div>
        </div>
        <div class="bg-white p-3 sm:p-4 rounded-xl border border-slate-200 shadow-sm border-l-4 border-l-rose-500 relative overflow-hidden">
          <div class="absolute top-0 right-0 p-3 opacity-10 text-rose-500 text-4xl"><i class="fa-solid fa-file-excel"></i></div>
          <span class="text-xs font-semibold text-rose-600 relative z-10">未成交 / 比率</span>
          <div class="mt-1 flex items-baseline justify-between relative z-10">
            <span class="text-xl sm:text-2xl font-bold text-rose-700">{{ stats.lost }} <span class="text-xs font-light text-rose-600/70">件</span></span>
            <span class="text-xs sm:text-sm font-medium text-rose-800 bg-rose-50 border border-rose-100 px-2 py-0.5 rounded-full">{{ stats.lostRate }}%</span>
          </div>
        </div>
        <div class="col-span-2 xl:col-span-1 bg-gradient-to-br from-blue-900 to-blue-800 text-white p-3 sm:p-4 rounded-xl border border-blue-900 shadow-sm relative overflow-hidden">
          <div class="absolute top-0 right-0 p-3 opacity-10 text-white text-5xl"><i class="fa-solid fa-coins"></i></div>
          <span class="text-xs font-semibold text-blue-200 relative z-10">當期成交額</span>
          <div class="mt-1 flex items-baseline justify-between relative z-10">
            <span class="text-xl sm:text-2xl font-bold tracking-wider">${{ stats.totalAmount.toLocaleString() }}</span>
          </div>
        </div>
      </div>

      <!-- 篩選列 -->
      <div class="bg-white p-3 sm:p-4 rounded-xl border border-slate-200 shadow-sm flex flex-wrap gap-2.5 items-center justify-between">
        <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
          <div class="relative w-full sm:w-56">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
            <input v-model="filterKeyword" type="text" placeholder="搜尋案名、客戶或備忘..." 
                   class="pl-8 pr-3 py-1.5 w-full text-xs sm:text-sm border border-slate-300 rounded-lg focus:ring-1 focus:ring-blue-800 focus:border-blue-800 focus:outline-none transition font-light">
          </div>
          <select v-model="filterOwner" class="py-1.5 px-2.5 text-xs sm:text-sm border border-slate-300 rounded-lg focus:ring-1 focus:ring-blue-800 focus:border-blue-800 focus:outline-none transition font-light">
            <option value="">所有負責人</option>
            <option v-for="owner in ownerOptions" :key="owner" :value="owner">{{ owner }}</option>
          </select>
          <select v-model="filterStatus" class="py-1.5 px-2.5 text-xs sm:text-sm border border-slate-300 rounded-lg focus:ring-1 focus:ring-blue-800 focus:border-blue-800 focus:outline-none transition font-light">
            <option value="">所有進度狀態</option>
            <option value="won">成交</option>
            <option value="pending">追蹤中</option>
            <option value="lost">未成交</option>
          </select>
        </div>
        <div class="text-xs text-slate-500">
          符合篩選：<strong class="text-blue-900 font-bold text-sm">{{ filteredList.length }}</strong> 筆
        </div>
      </div>

      <!-- 手機版視圖 (右側直向日期) -->
      <div class="block md:hidden space-y-3">
        <div v-for="item in filteredList" :key="item.id" class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm relative flex gap-3">
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between mb-3">
              <button @click="toggleStatus(item)" class="text-xs font-semibold px-2 py-0.5 rounded-full flex items-center gap-1 border shadow-sm transition"
                      :class="{
                        'bg-emerald-50 text-emerald-800 border-emerald-200': item.status === 'won',
                        'bg-amber-50 text-amber-800 border-amber-200': item.status === 'pending',
                        'bg-rose-50 text-rose-800 border-rose-200': item.status === 'lost'
                      }">
                <i class="fa-solid" :class="{'fa-check': item.status==='won', 'fa-exclamation': item.status==='pending', 'fa-xmark': item.status==='lost'}"></i>
                {{ item.status === 'won' ? '成交' : item.status === 'pending' ? '追蹤中' : '未成交' }}
              </button>
              <div class="flex items-center gap-4">
                <button @click="openModal(item)" class="text-slate-300 hover:text-blue-800 transition"><i class="fa-solid fa-pen-to-square"></i></button>
                <button @click="deleteItem(item.id)" class="text-slate-300 hover:text-rose-600 transition"><i class="fa-solid fa-trash"></i></button>
              </div>
            </div>

            <div class="flex justify-between items-baseline mb-2">
              <div>
                <h3 class="text-base font-bold text-blue-950 truncate max-w-[160px]">{{ item.caseName }}</h3>
                <p class="text-xs text-slate-500 mt-0.5"><i class="fa-regular fa-user mr-1 text-slate-300"></i>{{ item.customerName }}</p>
              </div>
              <span class="text-xs bg-[#F0F4F8] px-2 py-0.5 rounded border border-slate-200 text-blue-900 font-medium">
                {{ item.owner }}
              </span>
            </div>

            <div v-if="item.status === 'pending' && item.followUpDate" class="mb-2 text-xs flex items-center gap-1.5 p-1.5 rounded-lg border"
                 :class="isNearFollowUp(item.followUpDate) ? 'bg-amber-50 text-amber-800 font-medium border-amber-200' : 'bg-slate-50 text-slate-500 border-slate-100'">
              <i class="fa-solid fa-clock"></i> 下次追蹤：{{ item.followUpDate }}
              <span v-if="isNearFollowUp(item.followUpDate)" class="text-[10px] bg-amber-200 text-amber-900 px-1.5 rounded ml-auto">需追蹤</span>
            </div>

            <div v-if="item.status === 'won'" class="text-xs text-emerald-700 font-bold mb-2 tracking-wide">
              成交金額：${{ item.amount }}
            </div>
            <div v-else-if="item.status === 'lost'" class="text-xs text-rose-600 font-medium mb-2">
              未成交原因：{{ item.lostReason || '無紀錄' }}
            </div>

            <div v-if="item.report1 || item.report2 || item.report3" class="bg-blue-50/50 p-2 rounded-lg text-xs text-slate-600 space-y-1 border border-blue-100/50">
              <div v-if="item.report1"><span class="font-medium text-blue-300 mr-1">1.</span> {{ item.report1 }}</div>
              <div v-if="item.report2"><span class="font-medium text-blue-300 mr-1">2.</span> {{ item.report2 }}</div>
              <div v-if="item.report3"><span class="font-medium text-blue-300 mr-1">3.</span> {{ item.report3 }}</div>
            </div>
          </div>

          <!-- 右側直向日期 -->
          <div class="w-10 flex-shrink-0 flex flex-col items-center justify-center border-l border-slate-100 pl-3">
            <template v-if="item.date">
              <span class="text-[10px] text-slate-400 border-b border-slate-200 pb-1 mb-1 font-medium">{{ item.date.split('/')[0] }}</span>
              <span class="text-sm font-bold text-blue-900 leading-tight">{{ item.date.split('/')[1] }}</span>
              <span class="text-sm font-bold text-blue-900 leading-tight">{{ item.date.split('/')[2] }}</span>
            </template>
          </div>
        </div>
        
        <div v-if="filteredList.length === 0" class="text-center py-10 bg-white rounded-xl text-slate-400 text-sm border border-slate-200">
          無相符資料
        </div>
      </div>

      <!-- 電腦版表格視圖 -->
      <div class="hidden md:block bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-blue-50/50 text-blue-900 font-medium text-xs tracking-widest uppercase">
              <tr>
                <th class="px-3 py-4 text-center w-14 font-medium">進度</th>
                <th class="px-3 py-4 text-left w-24 font-medium">丈量日期</th>
                <th class="px-4 py-4 text-left font-medium">案名</th>
                <th class="px-3 py-4 text-left w-24 font-medium">客戶名</th>
                <th class="px-3 py-4 text-center w-20 font-medium">負責人</th>
                <th class="px-3 py-4 text-left w-32 font-medium">下次追蹤日</th>
                <th class="px-4 py-4 text-left font-medium">進度回報說明</th>
                <th class="px-4 py-4 text-left w-36 font-medium">金額/原因</th>
                <th class="px-3 py-4 text-center w-20 font-medium">操作</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <tr v-for="item in filteredList" :key="item.id" class="hover:bg-blue-50/30 transition">
                <td class="px-3 py-3.5 text-center">
                  <button @click="toggleStatus(item)" title="點選切換：成交 -> 追蹤 -> 未成交">
                    <span v-if="item.status === 'won'" class="inline-flex items-center justify-center w-7 h-7 bg-emerald-50 text-emerald-600 border border-emerald-200 rounded-full transition hover:bg-emerald-100">
                      <i class="fa-solid fa-check text-xs font-bold"></i>
                    </span>
                    <span v-else-if="item.status === 'pending'" class="inline-flex items-center justify-center w-7 h-7 bg-amber-50 text-amber-600 border border-amber-200 rounded-full transition hover:bg-amber-100">
                      <i class="fa-solid fa-exclamation text-xs font-bold"></i>
                    </span>
                    <span v-else class="inline-flex items-center justify-center w-7 h-7 bg-rose-50 text-rose-600 border border-rose-200 rounded-full transition hover:bg-rose-100">
                      <i class="fa-solid fa-xmark text-xs font-bold"></i>
                    </span>
                  </button>
                </td>
                <td class="px-3 py-3.5 whitespace-nowrap text-slate-500 font-medium text-xs">{{ item.date }}</td>
                <td class="px-4 py-3.5 font-bold text-blue-950">{{ item.caseName }}</td>
                <td class="px-3 py-3.5 whitespace-nowrap text-slate-700">{{ item.customerName }}</td>
                <td class="px-3 py-3.5 text-center whitespace-nowrap">
                  <span class="px-2 py-0.5 text-xs rounded-full font-medium bg-[#F0F4F8] text-blue-900 border border-slate-200">{{ item.owner }}</span>
                </td>
                <td class="px-3 py-3.5 whitespace-nowrap text-xs">
                  <div v-if="item.status === 'pending' && item.followUpDate" 
                       class="inline-flex items-center gap-1 px-2 py-0.5 rounded border"
                       :class="isNearFollowUp(item.followUpDate) ? 'bg-amber-50 text-amber-800 font-medium border-amber-200' : 'text-slate-500 border-transparent'">
                    <i class="fa-solid fa-clock text-[10px]"></i> {{ item.followUpDate }}
                  </div>
                  <span v-else class="text-slate-300">-</span>
                </td>
                <td class="px-4 py-3.5 text-xs text-slate-600 max-w-xs space-y-0.5">
                  <div v-if="item.report1" class="truncate"><span class="font-medium text-blue-300">1:</span> {{ item.report1 }}</div>
                  <div v-if="item.report2" class="truncate"><span class="font-medium text-blue-300">2:</span> {{ item.report2 }}</div>
                  <div v-if="item.report3" class="truncate"><span class="font-medium text-blue-300">3:</span> {{ item.report3 }}</div>
                </td>
                <td class="px-4 py-3.5 whitespace-nowrap text-xs">
                  <span v-if="item.status === 'won'" class="text-emerald-700 font-bold tracking-wide">${{ item.amount || '0' }}</span>
                  <span v-else-if="item.status === 'lost'" class="text-rose-600">{{ item.lostReason || '未成交' }}</span>
                  <span v-else class="text-slate-400 italic">追蹤中...</span>
                </td>
                <td class="px-3 py-3.5 text-center whitespace-nowrap">
                  <div class="flex items-center justify-center gap-2">
                    <button @click="openModal(item)" class="text-slate-300 hover:text-blue-800 transition p-1" title="編輯"><i class="fa-solid fa-pen-to-square"></i></button>
                    <button @click="deleteItem(item.id)" class="text-slate-300 hover:text-rose-600 transition p-1" title="刪除"><i class="fa-solid fa-trash"></i></button>
                  </div>
                </td>
              </tr>
              <tr v-if="filteredList.length === 0">
                <td colspan="9" class="px-4 py-16 text-center text-slate-400">
                  <div class="text-4xl mb-3 opacity-30"><i class="fa-solid fa-folder-open"></i></div>
                  <p>本月份無丈量資料</p>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div> <!-- 結束兩欄佈局 -->

  <!-- ==================== 智慧追蹤待辦提醒 彈窗 ==================== -->
  <div v-if="showReminderModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-blue-950/40 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl border border-blue-100 max-w-lg w-full p-5 max-h-[85vh] flex flex-col">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <div class="flex items-center gap-2">
          <span class="p-2 bg-amber-50 text-amber-600 border border-amber-100 rounded-lg">
            <i class="fa-solid fa-bell text-lg"></i>
          </span>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-blue-950">客戶追蹤提醒 <span class="text-xs font-light text-slate-500">(前後2天)</span></h3>
          </div>
        </div>
        <button @click="showReminderModal = false" class="text-slate-300 hover:text-slate-500 transition text-lg">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="overflow-y-auto py-3 space-y-2.5 flex-1 pr-1">
        <div v-for="c in dueReminders" :key="c.id" class="p-3 rounded-xl border border-amber-200 bg-amber-50/50 flex flex-col gap-1">
          <div class="flex justify-between items-baseline">
            <span class="font-bold text-blue-950 text-sm">{{ c.caseName }} - {{ c.customerName }}</span>
            <span class="text-xs font-medium px-2 py-0.5 rounded bg-amber-100 text-amber-800">
              {{ c.followUpDate }}
            </span>
          </div>
          <div class="text-xs text-slate-600">負責人：<strong class="font-medium">{{ c.owner }}</strong></div>
          <div v-if="c.report1 || c.report2" class="text-xs text-slate-600 bg-white p-2 rounded-lg border border-amber-100/50 mt-1">
            <span class="font-medium text-amber-700">備忘：</span>{{ c.report2 || c.report1 }}
          </div>
          <div class="flex justify-end gap-2 mt-1">
            <button @click="openModal(c); showReminderModal = false" class="text-xs font-medium text-blue-800 hover:text-blue-900 transition">
              立即更新進度 &rarr;
            </button>
          </div>
        </div>

        <div v-if="dueReminders.length === 0" class="text-center py-8 text-slate-400 text-sm">
          <i class="fa-solid fa-circle-check text-emerald-500 text-3xl mb-2 block opacity-50"></i>
          目前沒有這兩天內需要緊急追蹤的客戶！
        </div>
      </div>

      <div class="pt-3 border-t border-slate-100 flex justify-end">
        <button @click="showReminderModal = false" class="w-full sm:w-auto px-5 py-2.5 text-sm bg-blue-900 hover:bg-blue-800 text-white font-medium rounded-lg shadow-sm transition">
          我知道了，開始處理
        </button>
      </div>
    </div>
  </div>

  <!-- ==================== 新增/編輯 彈窗 ==================== -->
  <div v-if="isModalOpen" class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-blue-950/40 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl border border-blue-100 max-w-xl w-full p-5 sm:p-6 max-h-[92vh] overflow-y-auto">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="text-base sm:text-lg font-bold text-blue-950">{{ form.id ? '編輯丈量記錄' : '新增丈量記錄' }}</h3>
        <button @click="closeModal" class="text-slate-300 hover:text-slate-500 transition text-lg"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <form @submit.prevent="saveForm" class="mt-4 space-y-3.5 text-xs sm:text-sm font-light">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-medium text-slate-600 mb-1">丈量日期 *</label>
            <input v-model="form.date" type="text" placeholder="例: 2026/05/01" required class="w-full border border-slate-300 rounded-lg p-2 focus:ring-1 focus:ring-blue-800 focus:border-blue-800 focus:outline-none transition">
          </div>
          <div>
            <label class="block font-medium text-slate-600 mb-1">負責人 *</label>
            <input v-model="form.owner" list="owners" placeholder="詠舜 / 橙家..." required class="w-full border border-slate-300 rounded-lg p-2 focus:ring-1 focus:ring-blue-800 focus:border-blue-800 focus:outline-none transition">
            <datalist id="owners"><option v-for="owner in ownerOptions" :key="owner" :value="owner" /></datalist>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-medium text-slate-600 mb-1">案名 (地址/路名) *</label>
            <input v-model="form.caseName" type="text" placeholder="例: 員鹿路" required class="w-full border border-slate-300 rounded-lg p-2 focus:ring-1 focus:ring-blue-800 focus:border-blue-800 focus:outline-none transition">
          </div>
          <div>
            <label class="block font-medium text-slate-600 mb-1">客戶名 *</label>
            <input v-model="form.customerName" type="text" placeholder="例: 余先生" required class="w-full border border-slate-300 rounded-lg p-2 focus:ring-1 focus:ring-blue-800 focus:border-blue-800 focus:outline-none transition">
          </div>
        </div>
        <div>
          <label class="block font-medium text-slate-600 mb-1">目前進度狀態</label>
          <div class="grid grid-cols-3 gap-2">
            <button type="button" @click="form.status = 'won'" :class="form.status === 'won' ? 'bg-emerald-600 text-white font-medium border-emerald-700 shadow-inner' : 'bg-white text-slate-600 hover:bg-slate-50 border-slate-200'" class="py-2 rounded-lg border transition text-center"><i class="fa-solid fa-check mr-1"></i> 成交</button>
            <button type="button" @click="form.status = 'pending'" :class="form.status === 'pending' ? 'bg-amber-500 text-white font-medium border-amber-600 shadow-inner' : 'bg-white text-slate-600 hover:bg-slate-50 border-slate-200'" class="py-2 rounded-lg border transition text-center"><i class="fa-solid fa-exclamation mr-1"></i> 追蹤中</button>
            <button type="button" @click="form.status = 'lost'" :class="form.status === 'lost' ? 'bg-rose-600 text-white font-medium border-rose-700 shadow-inner' : 'bg-white text-slate-600 hover:bg-slate-50 border-slate-200'" class="py-2 rounded-lg border transition text-center"><i class="fa-solid fa-xmark mr-1"></i> 未成交</button>
          </div>
        </div>
        <div v-if="form.status === 'pending'" class="bg-amber-50/50 p-3 rounded-lg border border-amber-200">
          <label class="block font-medium text-amber-900 mb-1 flex items-center gap-1"><i class="fa-regular fa-calendar-check text-amber-600"></i> 下次追蹤日期</label>
          <input v-model="form.followUpDate" type="date" class="w-full border border-amber-300 rounded-lg p-2 bg-white focus:ring-1 focus:ring-amber-500 focus:border-amber-500 focus:outline-none transition font-sans">
        </div>
        <div v-if="form.status === 'won'">
          <label class="block font-medium text-emerald-700 mb-1">成交金額 (元)</label>
          <input v-model="form.amount" type="text" placeholder="例: 10500" class="w-full border border-emerald-300 rounded-lg p-2 focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none transition">
        </div>
        <div v-else-if="form.status === 'lost'">
          <label class="block font-medium text-rose-700 mb-1">未成交原因</label>
          <input v-model="form.lostReason" type="text" placeholder="例: 預算不夠" class="w-full border border-rose-300 rounded-lg p-2 focus:ring-1 focus:ring-rose-500 focus:border-rose-500 focus:outline-none transition">
        </div>
        <div class="space-y-2 pt-2 border-t border-slate-100">
          <div>
            <label class="block font-medium text-slate-600 mb-1">進度回報 1</label>
            <input v-model="form.report1" type="text" class="w-full border border-slate-300 rounded-lg p-2 focus:ring-1 focus:ring-blue-800 focus:border-blue-800 focus:outline-none transition">
          </div>
          <div>
            <label class="block font-medium text-slate-600 mb-1">進度回報 2</label>
            <input v-model="form.report2" type="text" class="w-full border border-slate-300 rounded-lg p-2 focus:ring-1 focus:ring-blue-800 focus:border-blue-800 focus:outline-none transition">
          </div>
          <div>
            <label class="block font-medium text-slate-600 mb-1">進度回報 3</label>
            <input v-model="form.report3" type="text" class="w-full border border-slate-300 rounded-lg p-2 focus:ring-1 focus:ring-blue-800 focus:border-blue-800 focus:outline-none transition">
          </div>
        </div>
        <div class="flex justify-end gap-2 pt-3">
          <button type="button" @click="closeModal" class="px-4 py-2.5 text-slate-500 hover:bg-slate-100 rounded-lg transition font-medium">取消</button>
          <button type="submit" class="px-5 py-2.5 bg-blue-900 hover:bg-blue-800 text-white rounded-lg shadow-sm transition font-medium">儲存記錄</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ==================== Firebase 核心邏輯 ==================== -->
<script type="module">
  // 引入 Firebase v10 模組 (CDN)
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.10.0/firebase-app.js";
  import { getFirestore, collection, onSnapshot, addDoc, updateDoc, deleteDoc, doc } from "https://www.gstatic.com/firebasejs/10.10.0/firebase-firestore.js";

  // 您的 Firebase 設定金鑰
  const firebaseConfig = {
    apiKey: "AIzaSyAzngeF1F_6usk791wgmuYKKuarDaI2Lpc",
    authDomain: "ossen-measure.firebaseapp.com",
    projectId: "ossen-measure",
    storageBucket: "ossen-measure.firebasestorage.app",
    messagingSenderId: "612220996039",
    appId: "1:612220996039:web:090ffff662ea7eef5631e2",
    measurementId: "G-W5QB6W52W8"
  };

  // 初始化 Firebase 與 Firestore
  const firebaseApp = initializeApp(firebaseConfig);
  const db = getFirestore(firebaseApp);
  const recordsCollection = collection(db, "measurements"); // 資料表名稱：measurements

  const { createApp, ref, computed, onMounted } = window.Vue;

  createApp({
    setup() {
      const records = ref([]);
      const selectedMonth = ref("ALL");
      const filterKeyword = ref("");
      const filterOwner = ref("");
      const filterStatus = ref("");
      const isModalOpen = ref(false);
      const showReminderModal = ref(false);
      const ownerOptions = ["詠舜", "橙家", "柏村", "鼎均"];

      const form = ref({
        id: null, date: "", caseName: "", customerName: "", owner: "", status: "pending", followUpDate: "", amount: "", lostReason: "", report1: "", report2: "", report3: ""
      });

      const getMonthStr = (dateStr) => {
        if (!dateStr) return "";
        const parts = dateStr.replace(/\//g, "-").split("-");
        return parts.length >= 2 ? `${parts[0]}-${parts[1].padStart(2, "0")}` : "";
      };

      const availableMonths = computed(() => {
        const set = new Set();
        records.value.forEach(r => {
          const m = getMonthStr(r.date);
          if (m) set.add(m);
        });
        return Array.from(set).sort().reverse();
      });

      const isNearFollowUp = (targetDateStr) => {
        if (!targetDateStr) return false;
        const target = new Date(targetDateStr);
        target.setHours(0, 0, 0, 0);
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        return Math.round((target.getTime() - today.getTime()) / (1000 * 3600 * 24)) <= 2;
      };

      const dueReminders = computed(() => {
        return records.value.filter(r => r.status === "pending" && isNearFollowUp(r.followUpDate));
      });

      const filteredList = computed(() => {
        return records.value.filter(item => {
          if (selectedMonth.value !== "ALL" && getMonthStr(item.date) !== selectedMonth.value) return false;
          if (filterKeyword.value) {
            const kw = filterKeyword.value;
            if (!item.caseName.includes(kw) && !item.customerName.includes(kw) && !(item.report1 || "").includes(kw) && !(item.report2 || "").includes(kw)) return false;
          }
          if (filterOwner.value && item.owner !== filterOwner.value) return false;
          if (filterStatus.value && item.status !== filterStatus.value) return false;
          return true;
        });
      });

      const stats = computed(() => {
        const baseList = selectedMonth.value === "ALL" ? records.value : records.value.filter(r => getMonthStr(r.date) === selectedMonth.value);
        const total = baseList.length;
        const won = baseList.filter(r => r.status === "won").length;
        const pending = baseList.filter(r => r.status === "pending").length;
        const lost = baseList.filter(r => r.status === "lost").length;
        const wonRate = total > 0 ? ((won / total) * 100).toFixed(1) : "0.0";
        const pendingRate = total > 0 ? ((pending / total) * 100).toFixed(1) : "0.0";
        const lostRate = total > 0 ? ((lost / total) * 100).toFixed(1) : "0.0";
        const totalAmount = baseList
          .filter(r => r.status === "won" && r.amount)
          .reduce((sum, r) => sum + (parseInt(String(r.amount).replace(/[^0-9]/g, "")) || 0), 0);
        return { total, won, pending, lost, wonRate, pendingRate, lostRate, totalAmount };
      });

      onMounted(() => {
        // 即時監聽 Firestore 資料變化
        onSnapshot(recordsCollection, (snapshot) => {
          const loadedData = [];
          snapshot.forEach((docSnap) => {
            loadedData.push({ id: docSnap.id, ...docSnap.data() });
          });
          
          // 根據丈量日期降序排序 (越新越上面)
          loadedData.sort((a, b) => new Date(b.date) - new Date(a.date));
          records.value = loadedData;

          // 載入完畢後，如果有該月資料就跳過去
          if (selectedMonth.value === "ALL" && availableMonths.value.length > 0) {
            const currentMonth = getMonthStr(new Date().toLocaleDateString('zh-TW'));
            selectedMonth.value = availableMonths.value.includes(currentMonth) ? currentMonth : availableMonths.value[0];
          }

          // 檢查是否需要跳出追蹤提醒
          if (dueReminders.value.length > 0 && !showReminderModal.value) {
            showReminderModal.value = true;
          }
        });
      });

      const toggleStatus = async (item) => {
        const docRef = doc(db, "measurements", item.id);
        let newStatus = 'won';
        if (item.status === 'won') newStatus = 'pending';
        else if (item.status === 'pending') newStatus = 'lost';
        await updateDoc(docRef, { status: newStatus });
      };

      const openModal = (item = null) => {
        if (item) {
          form.value = JSON.parse(JSON.stringify(item));
        } else {
          const today = new Date();
          const y = today.getFullYear();
          const m = String(today.getMonth() + 1).padStart(2, "0");
          const d = String(today.getDate()).padStart(2, "0");
          form.value = { id: null, date: `${y}/${m}/${d}`, caseName: "", customerName: "", owner: ownerOptions[0], status: "pending", followUpDate: `${y}-${m}-${d}`, amount: "", lostReason: "", report1: "", report2: "", report3: "" };
        }
        isModalOpen.value = true;
      };

      const closeModal = () => { isModalOpen.value = false; };

      const saveForm = async () => {
        const dataToSave = { ...form.value };
        delete dataToSave.id; // 不把 id 寫進文件內容中，id 由 Firestore 產生

        if (form.value.id) {
          // 編輯更新
          const docRef = doc(db, "measurements", form.value.id);
          await updateDoc(docRef, dataToSave);
        } else {
          // 新增文件
          await addDoc(recordsCollection, dataToSave);
        }
        closeModal();
      };

      const deleteItem = async (id) => {
        if (confirm("確定要從雲端刪除這筆丈量資料嗎？")) {
          const docRef = doc(db, "measurements", id);
          await deleteDoc(docRef);
        }
      };

      const exportCSV = () => {
        let csvContent = "\uFEFF進度,丈量日期,案名,客戶名,負責人,下次追蹤日,進度回報1,進度回報2,進度回報3,成交金額,未成交原因\n";
        filteredList.value.forEach(r => {
          const st = { won: "成交", pending: "追蹤中", lost: "未成交" }[r.status];
          csvContent += `"${st}","${r.date}","${r.caseName}","${r.customerName}","${r.owner}","${r.followUpDate || ''}","${r.report1 || ''}","${r.report2 || ''}","${r.report3 || ''}","${r.amount || ''}","${r.lostReason || ''}"\n`;
        });
        const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
        const link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.setAttribute("download", `丈量進度表_${selectedMonth.value}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      };

      return {
        records, selectedMonth, availableMonths, filterKeyword, filterOwner, filterStatus, ownerOptions,
        filteredList, stats, isModalOpen, showReminderModal, dueReminders, form,
        openModal, closeModal, saveForm, deleteItem, toggleStatus, exportCSV, isNearFollowUp
      };
    }
  }).mount("#app");
</script>
</body>
</html>
